---
import Layout from "../layouts/Layout.astro";
import Summary from "../components/Summary.astro";
import Biography from "../components/Biography.astro";
import TechStack from "../components/TechStack.astro";
import ProjectGrid from "../components/ProjectGrid.svelte";
import { projects } from "../data/projects";
---

<Layout>
  <div class="w-[90vw] mx-auto">
    <h1
      class="mt-12 mb-2 text-4xl font-bold tracking-widest max-md:text-center"
    >
      HELLO THERE 👋
    </h1>
  </div>

  <div class="bg-secondary text-secondary-content mb-8">
    <div
      class="w-[90vw] mx-auto py-5 pb-8 flex justify-evenly gap-4 max-md:flex-col max-md:items-center"
    >
      <Summary />
      <Biography />
      <TechStack />
    </div>
  </div>

  <div class="flex justify-center pb-32">
    <a
      href="mailto:contact@phoenixofforce.dev"
      class="btn btn-primary btn-lg tracking-wide hover:scale-115 transition-all"
    >
      Contact Me
    </a>
  </div>

  <div class="w-[90vw] mx-auto pb-16">
    <h1 class="text-3xl font-bold tracking-widest text-center mb-6">
      MY LATEST PROJECTS
    </h1>
    <ProjectGrid projects={projects.slice(0, 4)} />
  </div>
</Layout>
