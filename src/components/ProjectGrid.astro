---
import ProjectCard from './ProjectCard.svelte';
import type { Project } from '../data/projects';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-wrap justify-center gap-6">
	{projects.map((project) => (
		<div class="w-80">
			<ProjectCard {project} />
		</div>
	))}
</div>
